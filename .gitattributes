# Keep imported firmware byte-for-byte, including mixed UTF-8/GBK and CRLF.
* -text

# Repository-owned documentation/configuration uses explicit line endings.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# This overrides extension rules for vendor-derived files and Keil sources.
Firmware/** -text
