{
  "configurations": [
    {
      "name": "BalanceCar (Keil Arm Compiler 6)",
      "compilerPath": "C:/Keil_v5/ARM/ARMCLANG/bin/armclang.exe",
      "compilerArgs": [
        "--target=arm-arm-none-eabi",
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard",
        "-fshort-enums",
        "-fshort-wchar"
      ],
      "intelliSenseMode": "windows-clang-arm",
      "includePath": [
        "${workspaceFolder}/Firmware/Core/Inc",
        "${workspaceFolder}/Firmware/USB_HOST/App",
        "${workspaceFolder}/Firmware/USB_HOST/Target",
        "${workspaceFolder}/Firmware/Drivers/STM32F4xx_HAL_Driver/Inc",
        "${workspaceFolder}/Firmware/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Firmware/Middlewares/ST/STM32_USB_Host_Library/Core/Inc",
        "${workspaceFolder}/Firmware/Middlewares/ST/STM32_USB_Host_Library/Class/HID/Inc",
        "${workspaceFolder}/Firmware/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
        "${workspaceFolder}/Firmware/Drivers/CMSIS/Include",
        "${workspaceFolder}/Firmware/BSP",
        "${workspaceFolder}/Firmware/Hiwonder/inc",
        "${workspaceFolder}/Firmware/Hiwonder/src"
      ],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32F401xC"
      ],
      "cStandard": "c99",
      "cppStandard": "c++11",
      "browse": {
        "path": [
          "${workspaceFolder}/Firmware/Core/Inc",
          "${workspaceFolder}/Firmware/USB_HOST/App",
          "${workspaceFolder}/Firmware/USB_HOST/Target",
          "${workspaceFolder}/Firmware/Drivers/STM32F4xx_HAL_Driver/Inc",
          "${workspaceFolder}/Firmware/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
          "${workspaceFolder}/Firmware/Middlewares/ST/STM32_USB_Host_Library/Core/Inc",
          "${workspaceFolder}/Firmware/Middlewares/ST/STM32_USB_Host_Library/Class/HID/Inc",
          "${workspaceFolder}/Firmware/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
          "${workspaceFolder}/Firmware/Drivers/CMSIS/Include",
          "${workspaceFolder}/Firmware/BSP",
          "${workspaceFolder}/Firmware/Hiwonder/inc",
          "${workspaceFolder}/Firmware/Hiwonder/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
